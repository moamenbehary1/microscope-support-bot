    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const filePath = String(($json.result && $json.result.file_path) || '');\nconst ext = (filePath.split('.').pop() || '').toLowerCase();\nconst types = { pdf: 'application/pdf', txt: 'text/plain', md: 'text/plain', csv: 'text/plain', json: 'text/plain', html: 'text/html', htm: 'text/html', jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', heic: 'image/heic', heif: 'image/heif' };\nconst mime = types[ext];\nconst binary = $input.item.binary || {};\nif (!mime || !binary.data) {\n  return { json: { supported: false, file_path: filePath, extension: ext } };\n}\nbinary.data.mimeType = mime;\nreturn { json: { supported: true, file_path: filePath, extension: ext }, binary };"
      },
      "id": "0d8b03b1-0cbe-4e7f-9f97-9d34e61e1db1",
      "name": "Detect File Type",
      "type": "n8n-nodes-base.code",
