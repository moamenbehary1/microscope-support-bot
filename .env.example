BOT_TOKEN=your_bot_token_here
SUPER_ADMIN_ID=your_super_admin_telegram_id_here
BACKUP_CHANNEL_ID=-100your_channel_id_here
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com/
FIREBASE_SECRET=your_firebase_secret_here
WHATSAPP_SUPPORT_NUMBER=+20xxxxxxxxxx
GEMINI_API_KEY=your_gemini_api_key_here

# ── Google Drive Integration (Registration Form only) ──────────────────────
# The ID of the Drive folder where registration PDFs will be uploaded.
# Found in the folder URL: drive.google.com/drive/folders/<FOLDER_ID>
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Paste your Service Account JSON key as a single-line string.
# Replace actual newlines in "private_key" with \n (backslash-n).
# See README.md for step-by-step instructions.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY\n-----END RSA PRIVATE KEY-----\n","client_email":"sa@project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
