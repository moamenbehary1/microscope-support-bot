modules = ["dart-3.10"]
build = "dart pub get"

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "dart pub get && PORT=5000 dart run bin/telegram_bot_cms.dart"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80