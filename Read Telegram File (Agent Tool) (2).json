        976,
        288
      ]
    },
    {
      "parameters": {
        "resource": "document",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3.5-flash",
          "cachedResultName": "Gemini 3.5 Flash"
        },
        "text": "Extract ALL the content of this file as plain text, in its original language, preserving headings, lists, formulas and code. If it is an image or a scanned page, transcribe every visible text and then briefly describe any diagrams, charts or figures. Do not summarize and do not add commentary.",
        "inputType": "binary",
        "options": {
          "maxOutputTokens": 16000
        }
      },
      "id": "ebb3d222-240d-40d1-a7e6-f382b10d2133",
      "name": "Read File With Gemini",
