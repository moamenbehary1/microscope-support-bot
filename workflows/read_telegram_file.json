{
  "name": "Read Telegram File (Agent Tool)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "file_id"
            }
          ]
        }
      },
      "id": "5a23c6f9-c3ed-466c-ad94-4d26b67ab8b5",
      "name": "When Agent Calls",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        192
      ]
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.file_id }}",
        "additionalFields": {}
      },
      "id": "964a8fe5-99cf-4ddb-96e7-30aad9732a5e",
      "name": "Download File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        224,
        192
      ],
      "webhookId": "a4334c91-add4-41a9-8d12-d8f05138209d",
      "credentials": {
        "telegramApi": {
          "id": "GGSbTXUQmdOP5yja",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ ($json.result.file_path || \"\").toLowerCase() }}",
                    "rightValue": ".pdf",
                    "operator": {
                      "type": "string",
                      "operation": "endsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pdf"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ /\\.(txt|md|csv|json|html?)$/i.test($json.result.file_path || \"\") }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "text"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unsupported"
        }
      },
      "id": "544d55ba-cf63-49f2-b026-cf09acffd6ad",
      "name": "Route By File Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        448,
        176
      ]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {
          "joinPages": true
        }
      },
      "id": "de73e236-2bf5-41b5-bb10-d5416a2548e1",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        720,
        128
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "status",
              "value": "ok",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "text",
              "value": "={{ ($json.text || \"\").slice(0, 60000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "83a466a4-6729-4824-b4a9-80f3583c2b78",
      "name": "Return PDF Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
