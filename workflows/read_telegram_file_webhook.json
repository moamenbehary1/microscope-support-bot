{
  "name": "Read Telegram File (Webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "read-file",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-node-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 192],
      "webhookId": "read-file-webhook"
    },
    {
      "parameters": {
        "resource": "file",
        "fileId": "={{ $json.body.file_id }}",
        "additionalFields": {}
      },
      "id": "wh-node-002",
      "name": "Download File",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [224, 192],
      "credentials": {
        "telegramApi": {
          "id": "telegram-cred-1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ ($json.result.file_path || '').toLowerCase() }}",
                    "rightValue": ".pdf",
                    "operator": {
                      "type": "string",
                      "operation": "endsWith"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "pdf"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": false,
                  "leftValue": "",
                  "typeValidation": "loose",
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ /\\.(txt|md|csv|json|html?)$/i.test($json.result.file_path || '') }}",
                    "rightValue": true,
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "text"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "unsupported"
        }
      },
      "id": "wh-node-003",
      "name": "Route By File Type",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [448, 192]
    },
    {
      "parameters": {
        "operation": "pdf",
        "options": {
          "joinPages": true
        }
      },
      "id": "wh-node-004",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [720, 80]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "status",
              "value": "ok",
              "type": "string"
            },
            {
              "id": "r2",
              "name": "text",
              "value": "={{ ($json.text || '').slice(0, 60000) }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "file_path",
              "value": "={{ $('Download File').item.json.result.file_path }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "wh-node-005",
      "name": "Return PDF",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [944, 80]
    },
    {
      "parameters": {
        "operation": "text",
        "destinationKey": "text",
        "options": {}
      },
      "id": "wh-node-006",
      "name": "Extract Plain Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [720, 272]
    },
    {
      "parameters": {
        "assignments": {
