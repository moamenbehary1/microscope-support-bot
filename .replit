run = "dart pub get && dart run bin/telegram_bot_cms.dart"
entrypoint = "bin/telegram_bot_cms.dart"

[deployment]
run = ["sh", "-c", "dart pub get && dart run bin/telegram_bot_cms.dart"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["dart"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "dart pub get && dart run bin/telegram_bot_cms.dart"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
