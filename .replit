run = "dart pub get && dart run bin/telegram_bot_cms.dart"
entrypoint = "bin/telegram_bot_cms.dart"

[deployment]
run = ["sh", "-c", "dart pub get && dart run bin/telegram_bot_cms.dart"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 5000
externalPort = 80

[nix]
channel = "stable-25_05"
packages = ["dart"]