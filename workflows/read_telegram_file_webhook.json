              "type": "string"
            },
            {
              "id": "t3",
              "name": "file_path",
              "value": "={{ $('Download File').item.json.result.file_path }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "wh-node-007",
      "name": "Return Text",
