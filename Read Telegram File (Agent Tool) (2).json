              "value": "={{ String(($json.content && $json.content.parts ? $json.content.parts.map(p => p.text || \"\").join(\"\\n\") : null) ?? $json.text ?? $json.output ?? \"\").slice(0, 60000) }}",
              "type": "string"
            }
